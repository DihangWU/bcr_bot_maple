<?xml version="1.0"?>
<package format="2">
	<name>bcr_bot</name>
	<version>2.0.0</version>
	<description>bcr_bot</description>

	<maintainer email="gaurav@blackcoffeerobotics.com">Gaurav Gupta</maintainer>
	<maintainer email="devanshu@blackcoffeerobotics.com">Devanshu Sharma</maintainer>
	<maintainer email="sai@blackcoffeerobotics.com">Sai Eswara</maintainer>
	<license>Apache License 2.0</license>

	<buildtool_depend>ament_cmake</buildtool_depend>
	<depend>geometry_msgs</depend>
	<depend>nav2_core</depend>
	<depend>nav2_costmap_2d</depend>
	<depend>nav2_util</depend>
	<depend>nav_msgs</depend>
	<depend>pluginlib</depend>
	<depend>rclcpp</depend>
	<depend>tf2_ros</depend>

	<exec_depend>ament_index_python</exec_depend>
	<exec_depend>launch</exec_depend>
	<exec_depend>launch_ros</exec_depend>
	<exec_depend>robot_state_publisher</exec_depend>
	<exec_depend>xacro</exec_depend>

	<export>
		<build_type>ament_cmake</build_type>
		<nav2_core plugin="${prefix}/astar_planner_plugin.xml" />
	</export>
</package>
